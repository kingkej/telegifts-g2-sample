{
  "name": "telegifts-g2",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "description": "TeleGifts for Even Realities G2 — glanceable Telegram gift market HUD, topic-aware moderator inbox, and 1-tap smart replies.",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --mode evenhub",
    "build": "tsc --noEmit && vite build --mode evenhub",
    "preview": "vite preview --mode evenhub",
    "relay": "node --env-file-if-exists=.env server/telegramRelay.mjs",
    "test": "node --test tests/*.test.mjs",
    "audit:public": "node scripts/auditPublicRepo.mjs",
    "simulate": "evenhub-simulator http://localhost:3000/?raw=1",
    "pack": "npm run build && evenhub pack app.json dist --sdk-ver 0.0.16 -o telegifts-g2.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "soundswallower": "0.6.3"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
