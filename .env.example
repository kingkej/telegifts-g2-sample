# Optional live Telegram Bot Relay configuration (server/telegramRelay.mjs)
# Leave unset to run the built-in interactive Telegram & Market demo mode out of the box.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
RELAY_HOST=localhost
RELAY_PORT=8787
RELAY_ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Required when binding RELAY_HOST outside loopback (e.g. 0.0.0.0 behind HTTPS reverse proxy)
RELAY_AUTH_TOKEN=
# Optional comma-separated channel IDs or @usernames allowed to push channel_post digest headlines
# (left empty = reject arbitrary unallowlisted channels)
RELAY_ALLOWED_CHANNELS=
# Enable Telegram Live Loop reactions (👀 on G2 tap, 👍 after send) and typing/upload_photo chat actions (set 0 to disable)
RELAY_REACTIONS=1
# Optional JSON file path to persist pairing, updateOffset, questions, and digest across relay restarts
RELAY_STATE_FILE=

# Optional local dev overrides (never bake shared secrets into a public .ehpk build —
# configure Relay URL + per-device Bearer Token at runtime in Explore -> Telegram Setup!)
VITE_TELEGRAM_RELAY_URL=
# Optional read-only market catalog base URL; defaults to deterministic bundled snapshot
VITE_MARKET_API_URL=
# Optional model overrides when using a 1-time in-memory LLM key in the browser Studio
VITE_OPENAI_MODEL=
VITE_GEMINI_MODEL=
VITE_GROQ_MODEL=
